local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- (Se mantiene la GUI anterior, añadimos el botón de Ghost)
-- [Nota: He añadido la lógica de GhostMode al toggle del script]

local ghostMode = false

-- Función para manipular la hitbox (Ghost Mode)
local function setGhostMode(enabled)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if enabled then
        -- Mueve la hitbox lejos del modelo visual para engañar a los atacantes
        hrp.CFrame = CFrame.new(0, -500, 0) 
        -- Hace el cuerpo "transparente" a colisiones
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    else
        -- Regresa a la posición normal
        hrp.CFrame = CFrame.new(0, 10, 0) -- Ajustar a la posición del mapa
    end
end

-- Integración en el loop existente:
RunService.RenderStepped:Connect(function(dt)
    if ghostMode then
        -- Lógica de Ghost: El cuerpo sigue donde tú caminas, 
        -- pero la hitbox se queda en un lugar seguro.
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            -- Mantenemos la lógica de no colisión
            char.HumanoidRootPart.CanCollide = false
        end
    end
end)

-- IMPORTANTE: Para Hide N Seek, usar esto con precaución.
-- Muchos juegos modernos tienen "Anti-Cheat" que detecta si tu HumanoidRootPart 
-- está lejos de tu cuerpo o si cambia de CFrame bruscamente.
