local function GetCharacter()
	return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
	local char = GetCharacter()
	return char:WaitForChild("HumanoidRootPart", 2)
end

-- Actualización en Vivo de coordenadas
RunService.RenderStepped:Connect(function()
	if LiveUpdate then
		local root = GetRoot()
		if root then
			local pos = root.Position
			InputX.Text = string.format("%.2f", pos.X)
			InputY.Text = string.format("%.2f", pos.Y)
			InputZ.Text = string.format("%.2f", pos.Z)
		end
	end
end)

ToggleLiveBtn.MouseButton1Click:Connect(function()
	LiveUpdate = not LiveUpdate
	if LiveUpdate then
		ToggleLiveBtn.Text = "En Vivo: ACTIVADO"
		ToggleLiveBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	else
		ToggleLiveBtn.Text = "En Vivo: PAUSADO (Editable)"
		ToggleLiveBtn.TextColor3 = Color3.fromRGB(255, 180, 100)
	end
end)

-- Guardar / Cargar Posiciones
SavePosBtn.MouseButton1Click:Connect(function()
	local root = GetRoot()
	if root then
		SavedCFrame = root.CFrame
		SaveData()
		SavePosBtn.Text = "¡Posición Guardada!"
		task.wait(1)
		SavePosBtn.Text = "Guardar Posición Actual"
