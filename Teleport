	end
end)

TeleportCustomBtn.MouseButton1Click:Connect(function()
	local x = tonumber(InputX.Text)
	local y = tonumber(InputY.Text)
	local z = tonumber(InputZ.Text)
	
	if x and y and z and GetRoot() then
		GetRoot().CFrame = CFrame.new(x, y, z)
	end
end)

-- Loop Teleport
LoopTPBtn.MouseButton1Click:Connect(function()
	LoopTP = not LoopTP
	if LoopTP then
		LoopTPBtn.Text = "Loop Teleport: ACTIVADO"
		LoopTPBtn.TextColor3 = Color3.fromRGB(100, 255, 150)
		
		LoopConnection = RunService.Heartbeat:Connect(function()
