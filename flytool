    GuiService.ErrorMessageChanged:Connect(function(msg)
        if getgenv().MendezFlyTool_Loaded then
            SaveCurrentState()
            local queue_teleport = syn and syn.queue_on_teleport or queue_on_teleport or fluxus and fluxus.queue_on_teleport
            if queue_teleport then
                queue_teleport([[
                    repeat task.wait() until game:IsLoaded()
                    task.wait(2)
                    local success, result = pcall(function()
                        return game:HttpGet("https://raw.githubusercontent.com/elmendezz/anti-afk-pro-script/refs/heads/main/flytool?t=" .. tostring(os.time()))
                    end)
                    if success and result then
                        loadstring(result)()
                    end
                ]])
            end

            if msg and (string.find(msg:lower(), "disconnect") or string.find(msg:lower(), "kicked")) then
                StarterGui:SetCore("SendNotification", {
                    Title = "Reconectando...",
                    Text = "Desconexión detectada. Reingresando al servidor...",
                    Duration = 3,
                })
                task.wait(3)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end
        end
    end)
end)
