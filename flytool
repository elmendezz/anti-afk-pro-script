-- [ FUNCIÓN DE RECARGA Y DESCARGA (CON ANTI-CACHÉ Y CONSERVACIÓN DE CONFIG) ] --
local function FetchAndExecuteUpdate()
    SaveCurrentState()
    
    -- Se añade ?t=os.time() para romper la caché del game:HttpGet
    local updateUrl = "https://raw.githubusercontent.com/elmendezz/anti-afk-pro-script/refs/heads/main/flytool?t=" .. tostring(os.time())
    local success, result = pcall(function()
        return game:HttpGet(updateUrl)
    end)
    
    if success and result and #result > 0 then
        StarterGui:SetCore("SendNotification", {
            Title = "MendezFlyTool",
            Text = "Script recargado exitosamente. Aplicando cambios...",
            Duration = 3,
        })
        task.wait(0.5)
        StopFlyAnimations()
        ScreenGui:Destroy()
        getgenv().MendezFlyTool_Loaded = false
        pcall(function()
            loadstring(result)()
        end)
    else
        StarterGui:SetCore("SendNotification", {
            Title = "MendezFlyTool",
            Text = "Error al conectar con GitHub.",
            Duration = 4,
        })
    end
end

-- Botón Refresh (🔄) en TitleBar
RefreshBtn.MouseButton1Click:Connect(function()
