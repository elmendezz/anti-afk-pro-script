-- Isolated Mobile Drag Logic (Prevents camera/character movement bleed)
local Drag = madebybloodofbatus
local dragging = false
local dragInput
local dragStart
local startPos

Drag.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Drag.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

Drag.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        local SmoothDrag = {
            Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        }
        TweenService:Create(Drag, TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), SmoothDrag):Play()
    end
end)

-- AutoClick Engine Loop
task.spawn(function()
    while getgenv().AutoClickExecuted do
        if getgenv().AutoClickEnabled then
            pcall(function()
                local posX, posY
                if getgenv().UseCustomPos then
                    posX = getgenv().CustomPosX
                    posY = getgenv().CustomPosY
                else
                    local mouse = LocalPlayer:GetMouse()
                    posX = mouse.X
                    posY = mouse.Y
                end
                
                VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, true, game, 0)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, false, game, 0)
            end)
        end
        task.wait(getgenv().ClickDelay or 0.1)
    end
end)

