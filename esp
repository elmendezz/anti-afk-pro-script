local ESPHolder = Instance.new("Folder")
ESPHolder.Name = "ESP_Objects"
ESPHolder.Parent = ScreenGui

local espCache = {}
local playersList = {}
local currentIndex = 1

local function updatePlayersList()
    playersList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playersList, player)
        end
    end
    if currentIndex > #playersList then
        currentIndex = 1
    end
end

Players.PlayerAdded:Connect(updatePlayersList)
Players.PlayerRemoving:Connect(updatePlayersList)
updatePlayersList()

local function createESP(player)
    if espCache[player] then return end

    local bill = Instance.new("BillboardGui")
    bill.Name = player.Name
    bill.AlwaysOnTop = true
    bill.Size = UDim2.new(0, 200, 0, 50)
    bill.StudsOffset = Vector3.new(0, 3, 0)
    bill.Parent = ESPHolder

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextScaled = false
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextStrokeTransparency = 0
    textLabel.Parent = bill

    espCache[player] = {Billboard = bill, Text = textLabel}
end

local function removeESP(player)
    if espCache[player] then
        espCache[player].Billboard:Destroy()
        espCache[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createESP(p) end
end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

RunService.RenderStepped:Connect(function()
    updatePlayersList()
    
    if #playersList > 0 then
        local currentTarget = playersList[currentIndex]
        if currentTarget then
            TargetLabel.Text = "Objetivo: " .. currentTarget.Name
        else
            TargetLabel.Text = "Objetivo: Ninguno"
        end
    else
        TargetLabel.Text = "Objetivo: Ninguno"
    end

    for player, data in pairs(espCache) do
        local character = player.Character
        local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
        local localChar = LocalPlayer.Character
        local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")

        if character and humanoidRootPart and localHRP then
            data.Billboard.Adornee = humanoidRootPart
            local distance = math.floor((localHRP.Position - humanoidRootPart.Position).Magnitude)
            
            local isFriend = false
            pcall(function()
                isFriend = LocalPlayer:IsFriendsWith(player.UserId)
            end)

            if isFriend then
                data.Text.TextColor3 = Color3.fromRGB(0, 255, 0) -- Verde para amigos
            else
                data.Text.TextColor3 = Color3.fromRGB(255, 0, 0) -- Rojo para enemigos
            end

            data.Text.Text = player.Name .. "\n[" .. distance .. " studs]"
            data.Billboard.Enabled = true
        else
            data.Billboard.Enabled = false
        end
    end
end)

PrevBtn.MouseButton1Click:Connect(function()
    if #playersList > 0 then
        currentIndex = currentIndex - 1
        if currentIndex < 1 then currentIndex = #playersList end
    end
end)

NextBtn.MouseButton1Click:Connect(function()
    if #playersList > 0 then
        currentIndex = currentIndex + 1
        if currentIndex > #playersList then currentIndex = 1 end
    end
end)

TpBtn.MouseButton1Click:Connect(function()
    if #playersList > 0 then
        local target = playersList[currentIndex]
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local localChar = LocalPlayer.Character
            if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                localChar.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
            end
        end
    end
end)

