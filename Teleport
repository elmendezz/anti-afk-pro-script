-- Función utilitaria para crear campos de texto (Coordenadas)
local function CreateCoordBox(name, posY)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0.9, 0, 0, 35)
    Frame.Position = UDim2.new(0.05, 0, 0, posY)
    Frame.BackgroundColor3 = Color3.fromRGB(30, 31, 34)
    Frame.Parent = MainFrame
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.2, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(232, 234, 237)
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 16
    Label.Parent = Frame

    local TextBox = Instance.new("TextBox")
    TextBox.Size = UDim2.new(0.8, -10, 1, 0)
    TextBox.Position = UDim2.new(0.2, 0, 0, 0)
    TextBox.BackgroundTransparency = 1
    TextBox.Text = "0"
    TextBox.TextColor3 = Color3.fromRGB(138, 180, 248)
    TextBox.Font = Enum.Font.Gotham
    TextBox.TextSize = 14
    TextBox.TextXAlignment = Enum.TextXAlignment.Left
    TextBox.Parent = Frame
    
    return TextBox
end

local BoxX = CreateCoordBox("X:", 70)
local BoxY = CreateCoordBox("Y:", 115)
local BoxZ = CreateCoordBox("Z:", 160)

-- Función utilitaria para botones
local function CreateButton(text, posY, color)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0.9, 0, 0, 40)
    Button.Position = UDim2.new(0.05, 0, 0, posY)
    Button.BackgroundColor3 = color or Color3.fromRGB(30, 31, 34)
    Button.Text = text
    Button.TextColor3 = Color3.fromRGB(232, 234, 237)
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 14
    Button.AutoButtonColor = false
    Button.Parent = MainFrame
    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 8)

    -- Animaciones
    Button.MouseEnter:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 47, 51)}):Play()
    end)
    Button.MouseLeave:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = color or Color3.fromRGB(30, 31, 34)}):Play()
    end)
    Button.MouseButton1Down:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.1), {Size = UDim2.new(0.85, 0, 0, 36), Position = UDim2.new(0.075, 0, 0, posY + 2)}):Play()
    end)
    Button.MouseButton1Up:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.1), {Size = UDim2.new(0.9, 0, 0, 40), Position = UDim2.new(0.05, 0, 0, posY)}):Play()
    end)

    return Button
end

local ToggleLiveBtn = CreateButton("Actualización en Vivo: ACTIVADO", 215)
local SaveBtn = CreateButton("Guardar Posición", 265, Color3.fromRGB(26, 115, 232))
local LoadBtn = CreateButton("Cargar Posición", 315)
local LoopToggleBtn = CreateButton("Loop Teleport: DESACTIVADO", 365, Color3.fromRGB(150, 40, 40))

-- Lógica de la Interfaz y Sistemas
ToggleLiveBtn.MouseButton1Click:Connect(function()
    LiveUpdate = not LiveUpdate
    if LiveUpdate then
        ToggleLiveBtn.Text = "Actualización en Vivo: ACTIVADO"
        ToggleLiveBtn.TextColor3 = Color3.fromRGB(138, 180, 248)
    else
        ToggleLiveBtn.Text = "Actualización en Vivo: DESACTIVADO"
        ToggleLiveBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)

SaveBtn.MouseButton1Click:Connect(function()
    local x = tonumber(BoxX.Text) or 0
    local y = tonumber(BoxY.Text) or 0
    local z = tonumber(BoxZ.Text) or 0
    TargetCFrame = CFrame.new(x, y, z)
    SaveConfig(x, y, z)
    SaveBtn.Text = "¡Guardado!"
    task.wait(1)
    SaveBtn.Text = "Guardar Posición"
end)

LoadBtn.MouseButton1Click:Connect(function()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = TargetCFrame
        -- Actualizar inputs si el live está desactivado
        if not LiveUpdate then
            BoxX.Text = string.format("%.2f", TargetCFrame.X)
            BoxY.Text = string.format("%.2f", TargetCFrame.Y)
            BoxZ.Text = string.format("%.2f", TargetCFrame.Z)
        end
    end
end)

LoopToggleBtn.MouseButton1Click:Connect(function()
    LoopTeleport = not LoopTeleport
    if LoopTeleport then
        LoopToggleBtn.Text = "Loop Teleport: ACTIVADO"
        LoopToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 40)
        
        -- Si iniciamos el loop y no estamos en live update, actualiza el TargetCFrame a lo que digan las cajas
        if not LiveUpdate then
            local x = tonumber(BoxX.Text) or 0
            local y = tonumber(BoxY.Text) or 0
            local z = tonumber(BoxZ.Text) or 0
            TargetCFrame = CFrame.new(x, y, z)
        end
    else
        LoopToggleBtn.Text = "Loop Teleport: DESACTIVADO"
        LoopToggleBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
    end
end)

-- Actualización por frame (Live Coordinates & Loop Teleport)
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if root then
        -- Live Update
        if LiveUpdate then
            BoxX.Text = string.format("%.2f", root.Position.X)
            BoxY.Text = string.format("%.2f", root.Position.Y)
            BoxZ.Text = string.format("%.2f", root.Position.Z)
        end

        -- Loop Teleport
        if LoopTeleport then
            root.CFrame = TargetCFrame
            -- Congelar la física para evitar glitches al spammear CFrame
            if char:FindFirstChild("Humanoid") then
                char.Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
            end
        end
    end
end)

-- Carga automática al iniciar (si existe el archivo)
if LoadConfig() then
    print("MendezTeleportTool: Configuración cargada automáticamente.")
end
