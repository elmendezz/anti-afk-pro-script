-- --- BUCLE DE AUTO CLICK (Soporte Multitouch via VIM) ---

task.spawn(function()
    while getgenv().AutoClickerExecuted do
        if getgenv().ClickingActive and #clickPoints > 0 then
            -- Recorrer todos los puntos definidos (Multitouch)
            for _, pointFrame in pairs(clickPoints) do
                if not getgenv().ClickingActive then break end -- Seguridad

                local x = pointFrame.AbsolutePosition.X + (pointFrame.AbsoluteSize.X / 2)
                local y = pointFrame.AbsolutePosition.Y + (pointFrame.AbsoluteSize.Y / 2) + 36 -- Offset barra Roblox

                -- Usar VirtualInputManager para simular toques/clicks en coordenadas exactas
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1) -- Click Presionado
                task.wait(0.01) -- Pequeña espera para que el juego registre el "tap"
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1) -- Click Soltado
            end
            -- Espera entre ráfagas de clicks basadas en CPS
            task.wait(clickInterval)
        else
            task.wait(0.1) -- Espera pasiva si no está activo
        end
    end
end)

