-- ==========================================
-- SISTEMA DE ARCHIVOS (SAVE / LOAD SEGURO)
-- ==========================================
local function SaveData()
	pcall(function()
		if writefile then
			local dataToSave = {}
			if SavedCFrame then
				local pos = SavedCFrame.Position
				dataToSave.MainSaved = {pos.X, pos.Y, pos.Z}
			end
			writefile(ConfigFileName, HttpService:JSONEncode(dataToSave))
		end
	end)
end

local function LoadData()
	pcall(function()
		if readfile and isfile and isfile(ConfigFileName) then
			local result = HttpService:JSONEncode(readfile(ConfigFileName))
			if result and result.MainSaved then
				SavedCFrame = CFrame.new(result.MainSaved[1], result.MainSaved[2], result.MainSaved[3])
			end
		end
	end)
end

task.spawn(LoadData)

-- ==========================================
-- FUNCIONALIDADES DE TELEPORT
-- ==========================================
local function GetRoot()
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	return char:FindFirstChild("HumanoidRootPart")
end

RunService.RenderStepped:Connect(function()
	if LiveUpdate then
		local root = GetRoot()
		if root then
			local pos = root.Position
			InputX.Text = string.format("%.1f", pos.X)
			InputY.Text = string.format("%.1f", pos.Y)
			InputZ.Text = string.format("%.1f", pos.Z)
		end
	end
end)

ToggleLiveBtn.MouseButton1Click:Connect(function()
	LiveUpdate = not LiveUpdate
	if LiveUpdate then
		ToggleLiveBtn.Text = "En Vivo: ACTIVADO"
		ToggleLiveBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	else
		ToggleLiveBtn.Text = "En Vivo: PAUSADO (Editable)"
		ToggleLiveBtn.TextColor3 = Color3.fromRGB(255, 180, 100)
	end
end)

SavePosBtn.MouseButton1Click:Connect(function()
	local root = GetRoot()
	if root then
		SavedCFrame = root.CFrame
		SaveData()
		SavePosBtn.Text = "¡Posición Guardada!"
		task.wait(1)
		SavePosBtn.Text = "Guardar Posición Actual"
	end
end)

TeleportSavedBtn.MouseButton1Click:Connect(function()
	if SavedCFrame and GetRoot() then
		GetRoot().CFrame = SavedCFrame
	end
end)

TeleportCustomBtn.MouseButton1Click:Connect(function()
	local x = tonumber(InputX.Text)
	local y = tonumber(InputY.Text)
	local z = tonumber(InputZ.Text)
	
	if x and y and z and GetRoot() then
		GetRoot().CFrame = CFrame.new(x, y, z)
	end
end)

LoopTPBtn.MouseButton1Click:Connect(function()
	LoopTP = not LoopTP
	if LoopTP then
		LoopTPBtn.Text = "Loop Teleport: ACTIVADO"
		LoopTPBtn.TextColor3 = Color3.fromRGB(100, 255, 150)
		
		LoopConnection = RunService.Heartbeat:Connect(function()
			if SavedCFrame and GetRoot() then
				GetRoot().CFrame = SavedCFrame
			end
		end)
	else
		LoopTPBtn.Text = "Loop Teleport: DESACTIVADO"
		LoopTPBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
		if LoopConnection then
			LoopConnection:Disconnect()
			LoopConnection = nil
		end
	end
end)

ManualSaveConfigBtn.MouseButton1Click:Connect(function()
	SaveData()
	ManualSaveConfigBtn.Text = "¡Configuración Guardada!"
	task.wait(1)
	ManualSaveConfigBtn.Text = "Guardar Config Manual"
end)

-- ==========================================
-- ANIMACIÓN Y DRAGGING LIBRE
-- ==========================================
local isMinimized = false
ToggleBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	local targetSize = isMinimized and UDim2.new(0, 320, 0, 45) or UDim2.new(0, 320, 0, 420)
	
	TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = targetSize
	}):Play()
	
	ToggleBtn.Text = isMinimized and "+" or "-"
end)

local dragging, dragStart, startPos

Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
	end
end)

Header.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)
