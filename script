		end
	until not getgenv().AntiAfkExecuted or pinglabel == nil
end)

-- Timer Logic
local saniye = 0
local dakika = 0
local saat = 0

getgenv().zamanbaslaticisi = true

task.spawn(function()
	while getgenv().zamanbaslaticisi do
		wait(1)
		saniye = saniye + 1

		if saniye >= 60 then
			saniye = 0
			dakika = dakika + 1
		end

		if dakika >= 60 then
			dakika = 0
			saat = saat + 1
		end

		if timerlabel then
			timerlabel.Text = saat..":"..dakika..":"..saniye
		end
	end
end)
