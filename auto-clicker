-- Native In-Game Touch Simulation Engine (Bypasses PC Input Mode) - Mezcla Pro
local function performNativeGameTouch(x, y)
    pcall(function()
        -- 1. Raycast para los ClickDetectors (Interacción 3D)
        local unitRay = Camera:ScreenPointToRay(x, y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        if LocalPlayer.Character then
            params.FilterDescendantsInstances = {LocalPlayer.Character, ScreenGui}
        else
            params.FilterDescendantsInstances = {ScreenGui}
        end
        
        local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, params)
        if result and result.Instance then
            local detector = result.Instance:FindFirstChildOfClass("ClickDetector") 
                or result.Instance.Parent:FindFirstChildOfClass("ClickDetector")
            
            if detector and fireclickdetector then
                fireclickdetector(detector)
            end
        end

        -- 2. Virtual click (Principal) para atrapar botones de la UI
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)

        -- 3. Activar la herramienta que tengas en la mano
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        end
    end)
end

-- Execution Loop using RunService (Non-blocking)
local accumulator = 0
local heartbeatConnection
heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
    if not getgenv().AutoClickerExecuted then 
        if heartbeatConnection then heartbeatConnection:Disconnect() end
        return 
    end
    if not getgenv().ClickingActive then return end
    if #clickPoints == 0 then return end

    accumulator = accumulator + deltaTime

    if accumulator >= clickInterval then
        accumulator = 0

        for _, pointFrame in ipairs(clickPoints) do
            if not getgenv().ClickingActive then break end

            local x = pointFrame.AbsolutePosition.X + (pointFrame.AbsoluteSize.X / 2)
            local y = pointFrame.AbsolutePosition.Y + (pointFrame.AbsoluteSize.Y / 2)

            task.defer(function()
                performNativeGameTouch(x, y)
            end)
        end
    end
end)

