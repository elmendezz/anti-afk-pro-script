local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Limpiar si ya existe
if PlayerGui:FindFirstChild("OrbitExecutorGui") then
    PlayerGui.OrbitExecutorGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "OrbitExecutorGui"
ScreenGui.Parent = PlayerGui
ScreenGui.ResetOnSpawn = false

-- Creación de la ventana principal
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.Size = UDim2.new(0, 270, 0, 300)
MainFrame.Position = UDim2.new(0.5, -135, 0.5, -150)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Visible = true -- Aseguramos que sea visible desde el inicio

-- Botón de testeo para verificar que el script funciona
local StatusLabel = Instance.new("TextLabel", MainFrame)
StatusLabel.Size = UDim2.new(1, 0, 0, 30)
StatusLabel.Text = "GUI Cargada - Orbit v5"
StatusLabel.TextColor3 = Color3.new(1, 1, 1)
StatusLabel.BackgroundTransparency = 1

-- ... (El resto del código anterior de botones y lógica mantiene su estructura) ...
-- NOTA: He cambiado 'CoreGui' por 'PlayerGui' para que no sea bloqueado.

warn("Script cargado correctamente. Si la GUI no aparece, presiona F9 para ver si hay errores en la consola.")

