-- [ ARREGLO DE ARRASTRE DE VENTANA (SIN BUG DE CÁMARA) ] --
local dragging, dragInput, dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

RunService.RenderStepped:Connect(function()
    -- Animar Fondo y Glow
    BgGradient.Rotation = BgGradient.Rotation + 0.5
    MainStroke.Transparency = 0.3 + 0.2 * math.sin(tick() * 3)
    RoundStroke.Transparency = MainStroke.Transparency

    -- Actualizar Arrastre
    if dragging and dragInput then
        local delta = dragInput.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- [ LÓGICA DE ACTUALIZACIÓN ] --
local function FetchAndExecuteUpdate(force)
    SaveCurrentState()
    local url = "https://raw.githubusercontent.com/elmendezz/anti-afk-pro-script/refs/heads/main/flytool?t=" .. os.time()
    if force then url = url .. "&nocache=true" end

    local success, result = pcall(function() return game:HttpGet(url) end)
    if success and result and #result > 0 then
        StarterGui:SetCore("SendNotification", { Title = "MendezFlyTool", Text = "Aplicando actualización...", Duration = 3 })
        task.wait(0.5)
        ScreenGui:Destroy()
        getgenv().MendezFlyTool_Loaded = false
        pcall(function() loadstring(result)() end)
    end
end

