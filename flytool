-- [ ACTUALIZACIÓN / RECARGA ] --
local function FetchAndExecuteUpdate()
    SaveCurrentState()
    local updateUrl = "https://raw.githubusercontent.com/elmendezz/anti-afk-pro-script/refs/heads/main/flytool?t=" .. tostring(os.time())
    local success, result = pcall(function() return game:HttpGet(updateUrl) end)
    
    if success and result and #result > 0 then
        StarterGui:SetCore("SendNotification", { Title = "MendezFlyTool", Text = "Script actualizado con éxito.", Duration = 3 })
        task.wait(0.5)
        StopFlyAnimations()
        ScreenGui:Destroy() BubbleGui:Destroy()
        getgenv().MendezFlyTool_Loaded = false
        pcall(function() loadstring(result)() end)
    else
        StarterGui:SetCore("SendNotification", { Title = "MendezFlyTool", Text = "Error al conectar con GitHub.", Duration = 4 })
    end
end

RefreshBtn.MouseButton1Click:Connect(function() TriggerHaptic() FetchAndExecuteUpdate() end)
UpdateBtn.MouseButton1Click:Connect(function() TriggerHaptic() FetchAndExecuteUpdate() end)

-- [ LÓGICA DE VUELO ] --
local BodyVelocity, BodyGyro
local lockedPosition = nil

local function StopFly()
    if BodyVelocity then BodyVelocity:Destroy() BodyVelocity = nil end
    if BodyGyro then BodyGyro:Destroy() BodyGyro = nil end
    lockedPosition = nil
    StopFlyAnimations()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character.Humanoid.PlatformStand = false
    end
end

local function StartFly()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local HRP = LocalPlayer.Character.HumanoidRootPart
    StopFly()
    SetupFlyAnimations()
    
    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.P = 9e4 BodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9) BodyGyro.CFrame = HRP.CFrame BodyGyro.Parent = HRP
    
    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.Velocity = Vector3.new(0,0,0) BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9) BodyVelocity.Parent = HRP
    
    LocalPlayer.Character.Humanoid.PlatformStand = true
end

if States.Flying then StartFly() end

VolarBtn.MouseButton1Click:Connect(function()
    TriggerHaptic()
    States.Flying = not States.Flying
    if States.Flying then StartFly() else StopFly() end
    SynchronizeUI()
end)

BoostBtn.MouseButton1Click:Connect(function()
    TriggerHaptic()
    States.FlySpeed = States.FlySpeed + 1
    if States.FlySpeed > 4 then States.FlySpeed = 0 end
    SynchronizeUI()
end)

task.spawn(function()
    RunService.RenderStepped:Connect(function()
        if States.Flying and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and BodyVelocity and BodyGyro then
            local HRP = LocalPlayer.Character.HumanoidRootPart
            local speed = Speeds[States.FlySpeed]
            local camCFrame = Camera.CFrame
            BodyGyro.CFrame = camCFrame
            
            local moveVector = Vector3.new(0, 0, 0)
            if Controls then moveVector = Controls:GetMoveVector() end
            
            if moveVector.Magnitude > 0 then
                lockedPosition = nil
                local velocityDir = (camCFrame.RightVector * moveVector.X) + (camCFrame.LookVector * (-moveVector.Z))
                BodyVelocity.Velocity = velocityDir * speed
                HRP.AssemblyLinearVelocity = Vector3.zero

                if currentIdleTrack and currentIdleTrack.IsPlaying then currentIdleTrack:Stop(0.1) end
                if currentFlyTrack and not currentFlyTrack.IsPlaying then currentFlyTrack:Play(0.1) end
            else
                if not lockedPosition then lockedPosition = HRP.Position end
                BodyVelocity.Velocity = Vector3.new(0, 0, 0)
                HRP.AssemblyLinearVelocity = Vector3.zero
                HRP.CFrame = CFrame.new(lockedPosition, lockedPosition + camCFrame.LookVector)

                if currentFlyTrack and currentFlyTrack.IsPlaying then currentFlyTrack:Stop(0.1) end
                if currentIdleTrack and not currentIdleTrack.IsPlaying then currentIdleTrack:Play(0.1) end
            end
        else
            lockedPosition = nil
        end
    end)
end)

