-- Establecer velocidad default del jugador local a 20
task.spawn(function()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = char:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.WalkSpeed = 20
    end
    LocalPlayer.CharacterAdded:Connect(function(newChar)
        local newHumanoid = newChar:WaitForChild("Humanoid", 5)
        if newHumanoid then
            newHumanoid.WalkSpeed = 20
        end
    end)
end)

local function getValidPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p)
        end
    end
    return list
end

local function updateSelectionDisplay()
    playersList = getValidPlayers()
    if #playersList == 0 then
        selectedTarget = nil
        SelectionLabel.Text = "Seleccionar: Ninguno"
        return
    end
    
    if currentIndex > #playersList then
        currentIndex = 1
    elseif currentIndex < 1 then
        currentIndex = #playersList
    end
    
    selectedTarget = playersList[currentIndex]
    SelectionLabel.Text = "Objetivo: " .. selectedTarget.Name
end

PrevButton.MouseButton1Click:Connect(function()
    currentIndex = currentIndex - 1
    updateSelectionDisplay()
end)

NextButton.MouseButton1Click:Connect(function()
    currentIndex = currentIndex + 1
    updateSelectionDisplay()
end)

ToggleButton.MouseButton1Click:Connect(function()
    isOrbiting = not isOrbiting
    if isOrbiting then
        ToggleButton.Text = "ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        pcall(function()
            ByeSound:Play()
        end)
    else
        ToggleButton.Text = "OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        pcall(function()
            ByeSound:Stop()
        end)
        -- Restaurar colisiones y estado normal al apagar
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                    part.Transparency = 0
                end
            end
        end
    end
end)

-- Lógica para reproducir Emote
EmoteButton.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local animIdNumber = tonumber(EmoteBox.Text)
    if not animIdNumber then return end

    if currentAnimationTrack then
        currentAnimationTrack:Stop()
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. tostring(animIdNumber)

    pcall(function()
        currentAnimationTrack = humanoid:LoadAnimation(animation)
        currentAnimationTrack:Play()
    end)
end)

-- Bucle principal de órbita, control de distancia, evasión de hitbox, noclip, sabotaje al objetivo y audio en bucle
RunService.RenderStepped:Connect(function(dt)
    updateSelectionDisplay()
    
    -- Mantener velocidad del jugador local en 20 constantemente
    local localChar = LocalPlayer.Character
    if localChar then
        local localHumanoid = localChar:FindFirstChildOfClass("Humanoid")
        if localHumanoid and localHumanoid.WalkSpeed ~= 20 then
            localHumanoid.WalkSpeed = 20
        end
    end

    if isOrbiting and selectedTarget and selectedTarget.Character then
        if not ByeSound.IsPlaying then
            pcall(function()
                ByeSound:Play()
            end)
        end

        local targetChar = selectedTarget.Character
        
        if targetChar:FindFirstChild("HumanoidRootPart") and localChar and localChar:FindFirstChild("HumanoidRootPart") then
            local targetHRP = targetChar.HumanoidRootPart
            local localHRP = localChar.HumanoidRootPart
            
            -- Sabotaje a la víctima: Reducir su velocidad a -10000 para bloquearlo y aplicarle pantalla en blanco
            local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
            if targetHumanoid then
                pcall(function()
                    targetHumanoid.WalkSpeed = -10000
                end)
            end
            
            -- Inyectar pantalla en blanco total al objetivo si se ejecuta desde cliente local
            pcall(function()
                local playerGui = targetChar:FindFirstChildOfClass("PlayerGui") or selectedTarget:FindFirstChild("PlayerGui")
                if playerGui and not playerGui:FindFirstChild("WhiteScreenSabotage") then
                    local targetScreenGui = Instance.new("ScreenGui")
                    targetScreenGui.Name = "WhiteScreenSabotage"
                    targetScreenGui.IgnoreGuiInset = true
                    targetScreenGui.ResetOnSpawn = false
                    targetScreenGui.Parent = playerGui
                    
                    local whiteFrame = Instance.new("Frame")
                    whiteFrame.Size = UDim2.new(1, 0, 1, 0)
                    whiteFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    whiteFrame.BorderSizePixel = 0
                    whiteFrame.Parent = targetScreenGui
                end
            end)
            
            -- Desactivar colisiones y aplicar transparencia parcial
            for _, part in ipairs(localChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            
            angle = angle + (dt * 5)
            
            -- Obtener distancia personalizada desde el TextBox de forma segura
            local radius = tonumber(DistBox.Text) or 6
            
            local offsetX = math.cos(angle) * radius
            local offsetZ = math.sin(angle) * radius
            
            -- Elevación vertical extra para romper con la altura de puntería estándar del enemigo
            local newPos = targetHRP.Position + Vector3.new(offsetX, 5, offsetZ)
            
            localHRP.CFrame = CFrame.new(newPos, targetHRP.Position)
            localHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    else
        if ByeSound.IsPlaying then
            pcall(function()
                ByeSound:Stop()
            end)
        end
    end
end)
