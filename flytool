-- [ CONTADORES EN VIVO ASÍNCRONOS ] --
task.spawn(function()
    local lastUpdate = tick()
    local frames = 0
    
    RunService.RenderStepped:Connect(function()
        frames = frames + 1
        local currentTick = tick()
        
        if currentTick - lastUpdate >= 1 then
            FPSLabel.Text = "FPS: " .. frames
            frames = 0
            lastUpdate = currentTick
            
            local ping = "N/A"
            pcall(function()
                ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            PingLabel.Text = "Ping: " .. ping .. " ms"
            
            local uptime = os.time() - States.StartTime
            local days = math.floor(uptime / 86400)
            local hours = math.floor((uptime % 86400) / 3600)
            local mins = math.floor((uptime % 3600) / 60)
            local secs = uptime % 60
            
            if days > 0 then
                TimeLabel.Text = string.format("Sesión: %dd %02dh %02dm %02ds", days, hours, mins, secs)
            else
                TimeLabel.Text = string.format("Sesión: %02dh %02dm %02ds", hours, mins, secs)
            end
        end
    end)
end)

-- [ AUTO-RECONEXIÓN Y PERMANENCIA ] --
task.spawn(function()
    GuiService.ErrorMessageChanged:Connect(function(msg)
        if getgenv().MendezFlyTool_Loaded then
            local queue_teleport = syn and syn.queue_on_teleport or queue_on_teleport or fluxus and fluxus.queue_on_teleport
            if queue_teleport then
                queue_teleport([[
                    repeat task.wait() until game:IsLoaded()
                    task.wait(2)
                    local success, result = pcall(function()
                        return game:HttpGet("https://raw.githubusercontent.com/elmendezz/anti-afk-pro-script/refs/heads/main/flytool")
                    end)
                    if success and result then
                        loadstring(result)()
                    end
                ]])
            end

            if msg and (string.find(msg:lower(), "disconnect") or string.find(msg:lower(), "kicked")) then
                StarterGui:SetCore("SendNotification", {
                    Title = "Reconectando...",
                    Text = "Desconexión detectada. Reingresando al servidor...",
                    Duration = 3,
                })
                task.wait(3)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end
        end
    end)
end)
