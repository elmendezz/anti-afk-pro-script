-- Direct Game-World Touch Execution Engine
task.spawn(function()
    while getgenv().AutoClickerExecuted do
        if getgenv().ClickingActive and #clickPoints > 0 then
            for _, pointFrame in pairs(clickPoints) do
                if not getgenv().ClickingActive then break end

                local x = pointFrame.AbsolutePosition.X + (pointFrame.AbsoluteSize.X / 2)
                local y = pointFrame.AbsolutePosition.Y + (pointFrame.AbsoluteSize.Y / 2)

                pcall(function()
                    -- Bypass UI click interceptors by injecting physical screen touch
                    VirtualInputManager:SendTouchEvent(1001, 0, x, y)
                    task.wait(0.01)
                    VirtualInputManager:SendTouchEvent(1001, 2, x, y)
                    
                    -- Backup VirtualUser click inside game canvas
                    VirtualUser:CaptureController()
                    VirtualUser:Button1Down(Vector2.new(x, y))
                    VirtualUser:Button1Up(Vector2.new(x, y))
                end)
            end
            task.wait(clickInterval)
        else
            task.wait(0.1)
        end
    end
end)

