LoadBtn.MouseButton1Click:Connect(function()
    if LoadConfig() then
        SetLiveUpdate(false) -- Apagar Live Update para ver qué cargamos
        BoxX.Text = string.format("%.2f", TargetCFrame.X)
        BoxY.Text = string.format("%.2f", TargetCFrame.Y)
        BoxZ.Text = string.format("%.2f", TargetCFrame.Z)
        
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = TargetCFrame
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        
        LoadBtn.Text = "¡Posición Cargada!"
        task.delay(1.5, function() LoadBtn.Text = "Cargar y Teleportar" end)
    end
end)

-- Sistema Loop Teleport Mejorado (Usando Coroutine independiente para respetar el Delay)
local loopCoroutine
LoopToggleBtn.MouseButton1Click:Connect(function()
    LoopTeleport = not LoopTeleport
    if LoopTeleport then
        LoopToggleBtn.Text = "Loop Teleport: ON"
        LoopToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 160, 50)
        
        -- Si iniciamos loop, tomar como destino lo que esté escrito en las cajas
        TargetCFrame = CFrame.new(tonumber(BoxX.Text) or 0, tonumber(BoxY.Text) or 0, tonumber(BoxZ.Text) or 0)
        
        loopCoroutine = task.spawn(function()
            while LoopTeleport do
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    root.CFrame = TargetCFrame
                    -- Evita que el jugador salga volando sin convertirse en ladrillo
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
                
                -- Respetar el delay escogido por el usuario
                if LoopDelay > 0 then
                    task.wait(LoopDelay)
                else
                    RunService.Heartbeat:Wait()
                end
            end
        end)
    else
        LoopToggleBtn.Text = "Loop Teleport: OFF"
        LoopToggleBtn.BackgroundColor3 = Color3.fromRGB(160, 50, 50)
        if loopCoroutine then task.cancel(loopCoroutine) end
    end
end)

-- Actualización en Vivo (RenderStepped)
RunService.RenderStepped:Connect(function()
    if LiveUpdate then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
