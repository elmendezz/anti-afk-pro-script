-- Bucle Asíncrono de Vuelo + Control de Animaciones
task.spawn(function()
    RunService.RenderStepped:Connect(function()
        if States.Flying and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and BodyVelocity and BodyGyro then
            local HRP = LocalPlayer.Character.HumanoidRootPart
            local speed = Speeds[States.FlySpeed]
            local camCFrame = Camera.CFrame
            BodyGyro.CFrame = camCFrame
            
            local moveVector = Vector3.new(0, 0, 0)
            if Controls then
                moveVector = Controls:GetMoveVector()
            end
            
            if moveVector.Magnitude > 0 then
                lockedPosition = nil
                local velocityDir = (camCFrame.RightVector * moveVector.X) + (camCFrame.LookVector * (-moveVector.Z))
                BodyVelocity.Velocity = velocityDir * speed
                HRP.AssemblyLinearVelocity = Vector3.zero

                if currentIdleTrack and currentIdleTrack.IsPlaying then
                    currentIdleTrack:Stop(0.1)
                end
                if currentFlyTrack and not currentFlyTrack.IsPlaying then
                    currentFlyTrack:Play(0.1)
                end
            else
                if not lockedPosition then
                    lockedPosition = HRP.Position
                end
                BodyVelocity.Velocity = Vector3.new(0, 0, 0)
                HRP.AssemblyLinearVelocity = Vector3.zero
                HRP.CFrame = CFrame.new(lockedPosition, lockedPosition + camCFrame.LookVector)

                if currentFlyTrack and currentFlyTrack.IsPlaying then
                    currentFlyTrack:Stop(0.1)
                end
                if currentIdleTrack and not currentIdleTrack.IsPlaying then
                    currentIdleTrack:Play(0.1)
                end
            end
        else
            lockedPosition = nil
        end
    end)
end)

