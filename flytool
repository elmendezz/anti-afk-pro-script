-- [ ACTUALIZAR ESTADÍSTICAS (FPS, PING, TIME) ] --
task.spawn(function()
    local lastUpdate, frames = tick(), 0
    RunService.RenderStepped:Connect(function()
        frames = frames + 1
        local currentTick = tick()
        if currentTick - lastUpdate >= 1 then
            FPSLabel.Text = "FPS: " .. frames
            frames, lastUpdate = 0, currentTick
            
            pcall(function()
                PingLabel.Text = "Ping: " .. math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) .. " ms"
            end)
            
            local uptime = os.time() - States.StartTime
            local h = math.floor(uptime / 3600)
            local m = math.floor((uptime % 3600) / 60)
            local s = uptime % 60
            TimeLabel.Text = string.format("Sesión: %02dh %02dm %02ds", h, m, s)
        end
    end)
end)
