-- Vibración Háptica (brr-brr-brr)
local function TriggerHaptic()
    pcall(function()
        if UserInputService:GetGamepadConnected(Enum.UserInputType.Gamepad1) then
            HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Large, 0.8)
            task.wait(0.15)
            HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Large, 0)
        end
    end)
end

-- [ ID DE ANIMACIONES DE VUELO ] --
local ANIM_IDS = {
    FlyIdle = "rbxassetid://507771019",
    FlyMove = "rbxassetid://507772104"
}

local currentFlyTrack = nil
local currentIdleTrack = nil

local function StopFlyAnimations()
    if currentFlyTrack then currentFlyTrack:Stop(0.2) currentFlyTrack:Destroy() currentFlyTrack = nil end
    if currentIdleTrack then currentIdleTrack:Stop(0.2) currentIdleTrack:Destroy() currentIdleTrack = nil end
end

local function SetupFlyAnimations()
    StopFlyAnimations()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

    local idleAnim = Instance.new("Animation") idleAnim.AnimationId = ANIM_IDS.FlyIdle
    local moveAnim = Instance.new("Animation") moveAnim.AnimationId = ANIM_IDS.FlyMove

    pcall(function()
        currentIdleTrack = animator:LoadAnimation(idleAnim) currentIdleTrack.Priority = Enum.AnimationPriority.Action currentIdleTrack.Looped = true
        currentFlyTrack = animator:LoadAnimation(moveAnim) currentFlyTrack.Priority = Enum.AnimationPriority.Action currentFlyTrack.Looped = true
    end)
end

