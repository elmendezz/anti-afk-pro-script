-- Creador de Botones
local function CreateButton(text, primary)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -8, 0, 38)
	btn.BackgroundColor3 = primary and Color3.fromRGB(168, 199, 250) or Color3.fromRGB(30, 31, 37)
	btn.TextColor3 = primary and Color3.fromRGB(18, 19, 22) or Color3.fromRGB(220, 220, 220)
	btn.Text = text
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 12
	btn.AutoButtonColor = false
	btn.Parent = Content

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = primary and Color3.fromRGB(168, 199, 250) or Color3.fromRGB(48, 50, 58)
	stroke.Thickness = 1
	stroke.Parent = btn

	return btn
end

-- Creador de Cajas de Texto Coordenadas
local function CreateCoordBox(placeholder)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0.31, 0, 0, 36)
	box.BackgroundColor3 = Color3.fromRGB(26, 27, 32)
	box.TextColor3 = Color3.fromRGB(230, 230, 230)
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = Color3.fromRGB(100, 100, 110)
	box.Font = Enum.Font.Gotham
	box.TextSize = 11
	box.Text = ""
	box.ClearTextOnFocus = false

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = box

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(45, 47, 54)
	stroke.Thickness = 1
	stroke.Parent = box

	return box
end

