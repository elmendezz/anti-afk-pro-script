-- ==========================================
-- SISTEMA DE ARCHIVOS (SAVE / LOAD)
-- ==========================================
local function SaveData()
	if writefile then
		local dataToSave = {
			SavedPositions = {}
		}
		if SavedCFrame then
			local pos = SavedCFrame.Position
			dataToSave.MainSaved = {pos.X, pos.Y, pos.Z}
		end
		local success, err = pcall(function()
			writefile(ConfigFileName, game:GetService("HttpService"):JSONEncode(dataToSave))
		end)
		if success then
			print("[MendezTP] Configuración guardada automáticamente para PlaceId: " .. PlaceId)
		end
	end
end

local function LoadData()
	if readfile and isfile and isfile(ConfigFileName) then
		local success, result = pcall(function()
			return game:GetService("HttpService"):JSONDecode(readfile(ConfigFileName))
		end)
		if success and result then
			if result.MainSaved then
				SavedCFrame = CFrame.new(result.MainSaved[1], result.MainSaved[2], result.MainSaved[3])
			end
			print("[MendezTP] Configuración cargada con éxito.")
		end
	end
end

