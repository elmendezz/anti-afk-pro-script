-- Funciones de Guardado/Carga
local function SaveConfig(x, y, z)
    local data = {X = x, Y = y, Z = z}
    local jsonData = HttpService:JSONEncode(data)
    writefile(ConfigPath, jsonData)
    SavedCoords = data
end

local function LoadConfig()
    if isfile(ConfigPath) then
        local success, result = pcall(function()
            -- Forzar lectura del archivo en tiempo real
            return HttpService:JSONDecode(readfile(ConfigPath))
        end)
        if success and result then
            SavedCoords = result
            TargetCFrame = CFrame.new(SavedCoords.X, SavedCoords.Y, SavedCoords.Z)
            return true
        end
    end
    return false
end

