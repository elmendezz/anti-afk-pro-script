-- --- NUEVOS CONTROLES DE AUTO CLICKER ---

local function createPoint(position)
    local pointNumber = #clickPoints + 1
    if pointNumber > 10 then return end -- Limite de 10 puntos multitouch

    local PointFrame = Instance.new("Frame")
    local UICornerPoint = Instance.new("UICorner")
    local PointLabel = Instance.new("TextLabel")

    PointFrame.Name = "ClickPoint_" .. pointNumber
    PointFrame.Parent = ScreenGui -- Fuera del frame principal para que se mueva por toda la pantalla
    PointFrame.Size = UDim2.new(0, 30, 0, 30)
    PointFrame.Position = position or UDim2.new(0.5, -15, 0.5, -15)
    PointFrame.BackgroundColor3 = Color3.fromRGB(0, 255, 127) -- Color neón del diseño original
    PointFrame.BorderSizePixel = 0
    PointFrame.Active = true
    PointFrame.ZIndex = 10 -- Por encima de casi todo

    -- Hacerlo circular
    UICornerPoint.CornerRadius = UDim.new(1, 0)
    UICornerPoint.Parent = PointFrame

    PointLabel.Parent = PointFrame
    PointLabel.Size = UDim2.new(1, 0, 1, 0)
    PointLabel.BackgroundTransparency = 1
    PointLabel.Font = Enum.Font.SourceSansBold
    PointLabel.Text = tostring(pointNumber)
    PointLabel.TextColor3 = Color3.fromRGB(30, 30, 30)
    PointLabel.TextSize = 20

    -- Lógica para arrastrar la bolita (Soporte Móvil)
    local dragging = false
    local dragInput, dragStart, startPos

    PointFrame.InputBegan:Connect(function(input)
        if not getgenv().EditingPositions then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = PointFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    PointFrame.InputChanged:Connect(function(input)
        if not getgenv().EditingPositions then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and getgenv().EditingPositions then
            local delta = input.Position - dragStart
            PointFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    table.insert(clickPoints, PointFrame)
end

