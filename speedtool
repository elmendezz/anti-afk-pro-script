-- Sistema de Arrastre Avanzado (Soporte táctil/ratón sin mover cámara)
local function makeDraggable(guiObject)
    local dragging = false
    local dragInput, dragStart, startPos

    -- Se crea un receptor invisible para capturar la entrada antes que la cámara del juego
    local dragOverlay = Instance.new("TextButton")
    dragOverlay.Size = UDim2.new(1, 0, 1, 0)
    dragOverlay.BackgroundTransparency = 1
    dragOverlay.Text = ""
    dragOverlay.ZIndex = 0
    dragOverlay.Parent = guiObject

    dragOverlay.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragOverlay.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

