local PosFileName = "angel200xp_pos.txt"

task.spawn(function()
    if readfile and isfile and isfile(PosFileName) then
        local savedData = readfile(PosFileName)
        if savedData and savedData ~= "" then
            local p = HttpService:JSONDecode(savedData)
            if p and p.PlaceId == game.PlaceId then
                local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                local hrp = char:WaitForChild("HumanoidRootPart", 5)
                if hrp then
                    task.wait(1)
                    hrp.CFrame = CFrame.new(p.X, p.Y, p.Z)
                end
            end
        end
        pcall(function() writefile(PosFileName, "") end)
    end
end)

