-- Point Creation Mechanism
local function createPoint(position)
    local pointNumber = #clickPoints + 1
    if pointNumber > 10 then return end

    local PointFrame = Instance.new("Frame")
    local UICornerPoint = Instance.new("UICorner")
    local PointLabel = Instance.new("TextLabel")

    PointFrame.Name = "ClickPoint_" .. pointNumber
    PointFrame.Parent = ScreenGui
    PointFrame.Size = UDim2.new(0, 34, 0, 34)
    PointFrame.Position = position or UDim2.new(0.5, -17, 0.4, -17)
    PointFrame.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
    PointFrame.Active = true
    PointFrame.InputTransparent = false -- Se bloquea para poder moverlo al inicio
    PointFrame.ZIndex = 100

    UICornerPoint.CornerRadius = UDim.new(1, 0)
    UICornerPoint.Parent = PointFrame

    PointLabel.Parent = PointFrame
    PointLabel.Size = UDim2.new(1, 0, 1, 0)
    PointLabel.BackgroundTransparency = 1
    PointLabel.Font = Enum.Font.SourceSansBold
    PointLabel.Text = tostring(pointNumber)
    PointLabel.TextColor3 = Color3.fromRGB(20, 20, 20)
    PointLabel.TextSize = 16

    local pointDragging = false
    local pointDragStart, pointStartPos, pTouch

    PointFrame.InputBegan:Connect(function(input)
        if not getgenv().EditingPositions then return end
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not pointDragging then
            pointDragging = true
            pTouch = input
            pointDragStart = input.Position
            pointStartPos = PointFrame.Position
        end
    end)

    PointFrame.InputChanged:Connect(function(input)
        if pointDragging and getgenv().EditingPositions and (input == pTouch or input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - pointDragStart
            PointFrame.Position = UDim2.new(pointStartPos.X.Scale, pointStartPos.X.Offset + delta.X, pointStartPos.Y.Scale, pointStartPos.Y.Offset + delta.Y)
        end
    end)

    PointFrame.InputEnded:Connect(function(input)
        if input == pTouch or input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            pointDragging = false
            pTouch = nil
        end
    end)

    table.insert(clickPoints, PointFrame)
end

