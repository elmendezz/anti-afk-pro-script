-- Creador de Botones Toggle
local function createToggle(name, yPos, defaultState, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 36)
    Btn.Position = UDim2.new(0, 0, 0, yPos)
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 13
    Btn.AutoButtonColor = false
    Btn.Parent = Container

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Btn

    local Stroke = Instance.new("UIStroke")
    Stroke.Thickness = 1
    Stroke.Parent = Btn

    local state = defaultState

    local function updateVisuals()
        if state then
            Btn.Text = name .. " : [ ACTIVADO ]"
            Btn.BackgroundColor3 = Color3.fromRGB(60, 40, 110)
            Btn.TextColor3 = Color3.fromRGB(200, 180, 255)
            Stroke.Color = Color3.fromRGB(140, 100, 255)
        else
            Btn.Text = name .. " : [ DESACTIVADO ]"
            Btn.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
            Btn.TextColor3 = Color3.fromRGB(150, 150, 180)
            Stroke.Color = Color3.fromRGB(45, 45, 65)
        end
    end

    updateVisuals()

    Btn.MouseButton1Click:Connect(function()
        state = not state
        updateVisuals()
        callback(state)
    end)
end

