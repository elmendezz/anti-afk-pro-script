-- MendezTeleportTool
-- Compatible con Delta y otros ejecutores modernos (requiere writefile, readfile, isfile, isfolder, makefolder)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlaceId = game.PlaceId

-- Configuración de Archivos
local FolderName = "MendezTeleportTool"
local ConfigPath = FolderName .. "/" .. tostring(PlaceId) .. ".json"

if not isfolder(FolderName) then
    makefolder(FolderName)
end

-- Variables de Estado
local LiveUpdate = true
local LoopTeleport = false
local TargetCFrame = CFrame.new(0, 0, 0)
local SavedCoords = {X = 0, Y = 0, Z = 0}

-- Funciones de Guardado/Carga
local function SaveConfig(x, y, z)
    local data = {X = x, Y = y, Z = z}
    local jsonData = HttpService:JSONEncode(data)
    writefile(ConfigPath, jsonData)
    SavedCoords = data
end

local function LoadConfig()
    if isfile(ConfigPath) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(ConfigPath))
        end)
        if success and result then
            SavedCoords = result
            TargetCFrame = CFrame.new(SavedCoords.X, SavedCoords.Y, SavedCoords.Z)
            return true
        end
    end
    return false
end

-- Prevenir duplicados
if CoreGui:FindFirstChild("MendezTeleportToolUI") then
    CoreGui.MendezTeleportToolUI:Destroy()
end

