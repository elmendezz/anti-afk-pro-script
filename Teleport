-- Función auxiliar para crear botones estilizados con animaciones
local function CreateButton(text, primary)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 38)
	btn.BackgroundColor3 = primary and Color3.fromRGB(168, 199, 250) or Color3.fromRGB(30, 31, 37)
	btn.TextColor3 = primary and Color3.fromRGB(18, 19, 22) or Color3.fromRGB(220, 220, 220)
	btn.Text = text
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 13
	btn.AutoButtonColor = false
	btn.Parent = Content

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = primary and Color3.fromRGB(168, 199, 250) or Color3.fromRGB(48, 50, 58)
	stroke.Thickness = 1
	stroke.Parent = btn

	-- Animaciones al pasar el mouse/tocar
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2), {
			BackgroundColor3 = primary and Color3.fromRGB(190, 215, 255) or Color3.fromRGB(42, 44, 52)
		}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2), {
			BackgroundColor3 = primary and Color3.fromRGB(168, 199, 250) or Color3.fromRGB(30, 31, 37)
		}):Play()
	end)

	return btn
end

-- Función auxiliar para cajas de texto de coordenadas
local function CreateCoordBox(placeholder)
	local box = Instance.new("TextBox")
