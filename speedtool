-- Bucle Principal
local lastSafeCFrame = nil

RunService.Stepped:Connect(function(deltaTime)
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")

    -- Smooth Speed Change Logic
    if isSmoothSpeed then
        if math.abs(walkSpeed - targetSpeed) > 0.5 then
            walkSpeed = math.clamp(walkSpeed + (targetSpeed - walkSpeed) * (deltaTime * 2), 1, maxSpeedLimit)
        else
            walkSpeed = targetSpeed
        end

        -- Alejar Cámara dinámicamente con la velocidad
        local targetZoom = math.clamp(128 + (walkSpeed * 0.8), defaultMaxZoom, 500)
        LocalPlayer.CameraMaxZoomDistance = targetZoom
    else
        walkSpeed = targetSpeed
    end

    -- Noclip
    if isNoclip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- TP Walk / Speed Logic
    if isTpWalk and hum and hrp and hum.MoveDirection.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (walkSpeed / 25))
    elseif not isTpWalk and hum then
        hum.WalkSpeed = walkSpeed
    end

    -- No Void Protection
    if isNoVoid and hrp then
        if hrp.Position.Y > defaultFallenY + 20 then
            lastSafeCFrame = hrp.CFrame
        elseif hrp.Position.Y <= defaultFallenY + 15 then
            if lastSafeCFrame then
                hrp.CFrame = lastSafeCFrame + Vector3.new(0, 10, 0)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)
