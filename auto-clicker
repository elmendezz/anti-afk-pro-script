-- Stats Logic (FPS)
local sec = nil
local FPS = {}

local function fre()
    local fr = tick()
    for index = #FPS,1,-1 do
        FPS[index + 1] = (FPS[index] >= fr - 1) and FPS[index] or nil
    end
    FPS[1] = fr
    local fps = (tick() - sec >= 1 and #FPS) or (#FPS / (tick() - sec))
    fps = math.floor(fps)
    fpslabel.Text = tostring(fps)
end

sec = tick()
RunService.RenderStepped:Connect(fre)

-- Stats Logic (Ping)
task.spawn(function()
    repeat
        task.wait(1)
        local success, result = pcall(function()
            return math.floor(game:GetService("Stats"):FindFirstChild("PerformanceStats").Ping:GetValue())
        end)
        if success and pinglabel then
            pinglabel.Text = tostring(result)
        end
    until not getgenv().AutoClickExecuted or pinglabel == nil
end)

-- Timer Logic
local saniye = 0
local dakika = 0
local saat = 0

getgenv().zamanbaslaticisi = true

task.spawn(function()
    while getgenv().zamanbaslaticisi do
        task.wait(1)
        saniye = saniye + 1

        if saniye >= 60 then
            saniye = 0
            dakika = dakika + 1
        end

        if dakika >= 60 then
            dakika = 0
            saat = saat + 1
        end

        if timerlabel then
            timerlabel.Text = saat..":"..dakika..":"..saniye
        end
    end
end)
