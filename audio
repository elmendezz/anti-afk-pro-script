-- Función para limpiar lista visual
local function clearList()
    for _, child in ipairs(scrollingFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
end

-- Función para escanear y rellenar la GUI
local function scanAndPopulate()
    clearList()
    local count = 0
    
    for _, descendant in ipairs(game:GetDescendants()) do
        if descendant:IsA("Sound") then
            count = count + 1
            
            -- Crear tarjeta para cada sonido
            local itemFrame = Instance.new("Frame")
            itemFrame.Size = UDim2.new(1, -10, 0, 40)
            itemFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
            itemFrame.Parent = scrollingFrame
            
            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 4)
            itemCorner.Parent = itemFrame
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(0.4, 0, 1, 0)
            nameLabel.Position = UDim2.new(0, 8, 0, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = descendant.Name
            nameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            nameLabel.TextSize = 12
            nameLabel.Font = Enum.Font.Gotham
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = itemFrame
            
            -- Botón Play
            local playBtn = Instance.new("TextButton")
            playBtn.Size = UDim2.new(0, 50, 0, 26)
            playBtn.Position = UDim2.new(0.42, 0, 0.5, -13)
            playBtn.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
            playBtn.Text = "Play"
            playBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            playBtn.TextSize = 11
            playBtn.Font = Enum.Font.GothamBold
            playBtn.Parent = itemFrame
            
            local pc = Instance.new("UICorner")
            pc.CornerRadius = UDim.new(0, 4)
            pc.Parent = playBtn
            
            -- Botón Stop
            local stopBtn = Instance.new("TextButton")
            stopBtn.Size = UDim2.new(0, 50, 0, 26)
            stopBtn.Position = UDim2.new(0.55, 0, 0.5, -13)
            stopBtn.BackgroundColor3 = Color3.fromRGB(178, 34, 34)
            stopBtn.Text = "Stop"
            stopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            stopBtn.TextSize = 11
            stopBtn.Font = Enum.Font.GothamBold
            stopBtn.Parent = itemFrame
            
            local sc = Instance.new("UICorner")
            sc.CornerRadius = UDim.new(0, 4)
            sc.Parent = stopBtn
            
            -- Botón Loop (Alternar Bucle)
            local loopBtn = Instance.new("TextButton")
            loopBtn.Size = UDim2.new(0, 50, 0, 26)
            loopBtn.Position = UDim2.new(0.68, 0, 0.5, -13)
            loopBtn.BackgroundColor3 = descendant.Looped and Color3.fromRGB(70, 130, 180) or Color3.fromRGB(80, 80, 90)
            loopBtn.Text = descendant.Looped and "Loop:ON" or "Loop:OFF"
            loopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            loopBtn.TextSize = 10
            loopBtn.Font = Enum.Font.GothamBold
            loopBtn.Parent = itemFrame
            
            local lc = Instance.new("UICorner")
            lc.CornerRadius = UDim.new(0, 4)
            lc.Parent = loopBtn
            
            -- Botón Volumen Alto/Bajo o Clonar reproducción local
            playBtn.MouseButton1Click:Connect(function()
                pcall(function()
                    descendant:Play()
                end)
            end)
            
            stopBtn.MouseButton1Click:Connect(function()
                pcall(function()
                    descendant:Stop()
                end)
            end)
            
            loopBtn.MouseButton1Click:Connect(function()
                descendant.Looped = not descendant.Looped
                loopBtn.Text = descendant.Looped and "Loop:ON" or "Loop:OFF"
                loopBtn.BackgroundColor3 = descendant.Looped and Color3.fromRGB(70, 130, 180) or Color3.fromRGB(80, 80, 90)
            end)
        end
    end
    
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, count * 45)
end

scanButton.MouseButton1Click:Connect(scanAndPopulate)

-- Escaneo automático inicial al abrir la GUI
scanAndPopulate()
