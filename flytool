-- [ ESTADÍSTICAS EN VIVO ] --
task.spawn(function()
    local lastUpdate = tick() local frames = 0
    RunService.RenderStepped:Connect(function()
        frames = frames + 1
        local currentTick = tick()
        if currentTick - lastUpdate >= 1 then
            FPSLabel.Text = "FPS: " .. frames frames = 0 lastUpdate = currentTick
            local ping = "N/A"
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            PingLabel.Text = "Ping: " .. ping .. " ms"
            
            local uptime = os.time() - States.StartTime
            local days = math.floor(uptime / 86400)
            local hours = math.floor((uptime % 86400) / 3600)
            local mins = math.floor((uptime % 3600) / 60)
            local secs = uptime % 60
            if days > 0 then
                TimeLabel.Text = string.format("Sesión: %dd %02dh %02dm %02ds", days, hours, mins, secs)
            else
                TimeLabel.Text = string.format("Sesión: %02dh %02dm %02ds", hours, mins, secs)
            end
        end
    end)
end)
