-- Loop Teleport
local loopCoroutine
LoopToggleBtn.MouseButton1Click:Connect(function()
    LoopTeleport = not LoopTeleport
    if LoopTeleport then
        LoopToggleBtn.Text = "Loop Teleport: ON"
        LoopToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 160, 50)
        
        TargetCFrame = CFrame.new(tonumber(BoxX.Text) or 0, tonumber(BoxY.Text) or 0, tonumber(BoxZ.Text) or 0)
        
        loopCoroutine = task.spawn(function()
            while LoopTeleport do
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    root.CFrame = TargetCFrame
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
                
                if LoopDelay > 0 then
                    task.wait(LoopDelay)
                else
                    RunService.Heartbeat:Wait()
                end
            end
        end)
    else
        LoopToggleBtn.Text = "Loop Teleport: OFF"
        LoopToggleBtn.BackgroundColor3 = Color3.fromRGB(160, 50, 50)
        if loopCoroutine then task.cancel(loopCoroutine) end
    end
end)

